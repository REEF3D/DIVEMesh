From 17b6d3c78907884ba2bd7dffca078955ba9b0e7c Mon Sep 17 00:00:00 2001
From: Hans Bihs <hans.bihs@ntnu.no>
Date: Fri, 13 Nov 2026 15:18:03 +0100
Subject: [PATCH] ray cast: different offsets of the ray in the two transverse
 directions

The ray of every cell was moved off the grid lines by the same small offset in
both transverse directions, i.e. along the 45 deg diagonal. A triangle edge on
that diagonal (the diagonal of a wedge face, e.g. T 61 0 6 -1 5 2 0 on a 5 cm
grid) then still ran through the ray, which missed both triangles: the bed of
those cells stayed at zmin (56 cells of a line of pits). The second offset is
now 0.7548776662 times the first (irrational ratio). Applies to ray_cast_x/y/z
and the inside-outside casts io_x, io_ycorr, io_zcorr.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XWYJ6ueMoPYzsegMW1kbzy
---
 src/geometry_ray_cast_io_x.cpp     | 7 +++++--
 src/geometry_ray_cast_io_ycorr.cpp | 7 +++++--
 src/geometry_ray_cast_io_zcorr.cpp | 7 +++++--
 src/geometry_ray_cast_x.cpp        | 7 +++++--
 src/geometry_ray_cast_y.cpp        | 7 +++++--
 src/geometry_ray_cast_z.cpp        | 7 +++++--
 6 files changed, 30 insertions(+), 12 deletions(-)

diff --git a/src/geometry_ray_cast_io_x.cpp b/src/geometry_ray_cast_io_x.cpp
index 04abe49..cf236ce 100644
--- a/src/geometry_ray_cast_io_x.cpp
+++ b/src/geometry_ray_cast_io_x.cpp
@@ -39,6 +39,9 @@ void geometry::ray_cast_io_x(lexer* p, dive* a, int ts, int te, intfield &flag,
     double u,v,w;
     double denom;
     double psi = 1.0e-8*p->DXM;
+    // the two offsets of the ray differ (irrational ratio): with equal offsets the ray stayed on a triangle
+    // edge at 45 deg to the grid (the diagonal of a wedge face) and missed both triangles
+    double psi2 = 0.7548776662*psi;
 
 
     MALOOP
@@ -100,11 +103,11 @@ void geometry::ray_cast_io_x(lexer* p, dive* a, int ts, int te, intfield &flag,
         {
             Px = p->xmin-10.0*p->DXM;
             Py = p->YP[JP]+psi;
-            Pz = p->ZP[KP]+psi;
+            Pz = p->ZP[KP]+psi2;
 
             Qx = p->xmax+10.0*p->DXM;
             Qy = p->YP[JP]+psi;
-            Qz = p->ZP[KP]+psi;
+            Qz = p->ZP[KP]+psi2;
 
 
             PQx = Qx-Px;
